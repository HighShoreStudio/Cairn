<UserControl x:Class="HighshoreCairn.Views.ProjectListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:HighshoreCairn.Helpers">
    <Grid Background="{DynamicResource Brush.Background}">
        <Grid MaxWidth="980" Margin="24,20,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" Command="{Binding NewCommand}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="New Project" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Projects" />
                    <TextBlock Style="{StaticResource Muted}" Text="Double-click a project to open its board." />
                </StackPanel>
            </DockPanel>

            <!-- Actions on the selected project -->
            <DockPanel Grid.Row="1" Margin="0,14,0,10">
                <!-- Shown only while a project is the default template for new projects -->
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Restore Original Template"
                        Command="{Binding RestoreTemplateCommand}" ToolTip="{Binding TemplateToolTip}"
                        Visibility="{Binding HasTemplate, Converter={StaticResource BoolToVis}}" />
                <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Btn}" Content="Open" Command="{Binding OpenCommand}"
                        IsEnabled="{Binding HasSelection}" Margin="0,0,6,0" />
                <Button Style="{StaticResource Btn}" Content="Settings" Command="{Binding SettingsCommand}"
                        IsEnabled="{Binding HasSelection}" Margin="0,0,6,0" />
                <Button Style="{StaticResource Btn.Danger}" Content="Delete" Command="{Binding DeleteCommand}"
                        IsEnabled="{Binding HasSelection}" Margin="0,0,6,0" />
                <Button Style="{StaticResource Btn.Ghost}" Content="Remove from list" Command="{Binding ForgetCommand}"
                        IsEnabled="{Binding HasSelection}" Margin="0,0,18,0"
                        ToolTip="Forget the project on this PC without deleting its files" />
                <Button Style="{StaticResource Btn.Ghost}" Content="Open Folder…" Command="{Binding AddExistingCommand}"
                        ToolTip="Add an existing project folder (for example a git clone)" />
                <!-- Shown only while the selected project has deleted documents in docs/.trash -->
                <Button Style="{StaticResource Btn.Ghost}" Content="Trash Folder" Command="{Binding OpenTrashCommand}" Margin="6,0,0,0"
                        ToolTip="Opens the docs/.trash folder of the selected project in Explorer: the documents deleted (or converted) in the Documentation area are kept there until you remove them."
                        Visibility="{Binding HasTrash, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </DockPanel>

            <ListBox Grid.Row="2" x:Name="ProjectsList" Style="{StaticResource RowList}"
                     ItemsSource="{Binding Projects}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                     MouseDoubleClick="OnDoubleClick" KeyDown="OnKeyDown"
                     Visibility="{Binding HasProjects, Converter={StaticResource BoolToVis}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <!-- Thumb -->
                            <Grid DockPanel.Dock="Left" Width="52" Height="52" Margin="2,2,14,2">
                                <Border CornerRadius="10" Background="{Binding Color, Converter={StaticResource HexToBrush}}">
                                    <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="18" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <!-- Project icon (when one is set) covers the colored initials -->
                                <Border CornerRadius="10" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Icon, Converter={StaticResource Base64ToImage}}" Stretch="UniformToFill"
                                                    RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.AccentLight}" CornerRadius="9" Padding="8,1" Margin="8,0,0,0"
                                            VerticalAlignment="Center" ToolTip="New projects start from the customization of this project"
                                            Visibility="{Binding IsTemplate, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Default template" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0" Text="{Binding Meta}" />
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding Dates}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Folder}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="32" VerticalAlignment="Top"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource H2}" Text="No projects yet" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,14" HorizontalAlignment="Center"
                               Text="Create your first project to get a Kanban board with TODO, In Progress and Done." />
                    <Button Style="{StaticResource Btn.Primary}" Content="New Project" Command="{Binding NewCommand}"
                            HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
