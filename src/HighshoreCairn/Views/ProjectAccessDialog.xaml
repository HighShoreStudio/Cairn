<Window x:Class="HighshoreCairn.Views.ProjectAccessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:HighshoreCairn.Helpers"
        Title="Project access"
        Style="{StaticResource WindowBase}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Button Style="{StaticResource Btn}" Content="Cancel" IsCancel="True" MinWidth="84" HorizontalAlignment="Right" />
        </Border>
        <StackPanel Margin="18,14,18,18">
            <TextBlock Style="{StaticResource H2}" Text="{Binding ProjectName}" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,0" />

            <!-- Option 1: login with an account that is already in the project -->
            <Border Style="{StaticResource Card}" Padding="12,4,12,12" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="Login as a user of this project" />
                    <ComboBox ItemsSource="{Binding Members}" SelectedItem="{Binding SelectedMember, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <h:Avatar Initials="{Binding Initials}" Color="{Binding AvatarColor}" Image="{Binding AvatarImage}" Size="20" />
                                    <TextBlock Text="{Binding Username}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Style="{StaticResource Label}" Text="Password" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" Content="Login" IsDefault="True"
                                Command="{Binding LoginCommand}" Margin="6,0,0,0" MinWidth="76" />
                        <PasswordBox h:PasswordBoxHelper.Attach="True"
                                     h:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <!-- Option 2 / 3: join with the current account, or create a new one -->
            <TextBlock Style="{StaticResource Label}" Text="Or" />
            <Button Style="{StaticResource Btn}" Content="{Binding JoinText}" Command="{Binding JoinCommand}"
                    HorizontalContentAlignment="Left" Margin="0,0,0,6"
                    ToolTip="Add your current account to the authorized users of this project" />
            <Button Style="{StaticResource Btn}" Content="Create a new account for this project…" Command="{Binding CreateCommand}"
                    HorizontalContentAlignment="Left" />
        </StackPanel>
    </DockPanel>
</Window>
