<Window x:Class="HighshoreCairn.Views.CardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:HighshoreCairn.Helpers"
        Title="{Binding WindowTitle}"
        Style="{StaticResource WindowBase}"
        Width="940" Height="700" MinWidth="760" MinHeight="520"
        ShowInTaskbar="False"
        Loaded="OnLoaded">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="Enter" Command="{Binding SaveCommand}" />
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Tag chip that can be switched on/off -->
        <Style x:Key="TagToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,5,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="10" Padding="9,2" BorderThickness="1"
                                BorderBrush="{Binding Color, Converter={StaticResource HexToBrush}}"
                                Background="{Binding Color, Converter={StaticResource HexToBrush}}">
                            <TextBlock x:Name="Tx" Text="{Binding Name}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                                <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ===== Footer ===== -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource Btn}" Content="Cancel" IsCancel="True" MinWidth="84" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Btn.Primary}" Content="Save" Command="{Binding SaveCommand}" MinWidth="84"
                            ToolTip="Ctrl+Enter" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding MetaText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Foreground="{DynamicResource Brush.Danger}" Text="{Binding Error}" FontWeight="SemiBold"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="16,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- ===================== Main column ===================== -->
            <ScrollViewer Focusable="False" Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="Title *" Margin="0,0,0,4" />
                    <TextBox x:Name="TitleBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="16" FontWeight="SemiBold" />

                    <DockPanel Margin="0,12,0,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Padding="6,1" IsTabStop="False"
                                Content="{Binding PreviewButtonText}" Command="{Binding TogglePreviewCommand}" />
                        <TextBlock Style="{StaticResource Label}" Margin="0" Text="Description (markdown)" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="False"
                             TextWrapping="Wrap" MinHeight="110" MaxHeight="230" VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Visibility="{Binding ShowEditor, Converter={StaticResource BoolToVis}}" />
                    <Border Style="{StaticResource Card}" CornerRadius="4" Padding="10,8" MinHeight="110" MaxHeight="230"
                            Visibility="{Binding ShowPreview, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto">
                            <TextBlock TextWrapping="Wrap" h:Markdown.Text="{Binding Description}" />
                        </ScrollViewer>
                    </Border>

                    <!-- ===== Checklist ===== -->
                    <DockPanel Margin="0,14,0,4">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="{Binding ChecklistProgress}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Label}" Margin="0" Text="Checklist" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Checklist}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,3">
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Done, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="24" Height="24" ToolTip="Remove item"
                                            Command="{Binding DataContext.RemoveChecklistItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" />
                                    </Button>
                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0,0,0,1" Background="Transparent" Padding="2,3" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Add" Command="{Binding AddChecklistItemCommand}" Margin="6,0,0,0" />
                        <TextBox Text="{Binding NewChecklistText, UpdateSourceTrigger=PropertyChanged}" ToolTip="New checklist item (Enter to add)">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddChecklistItemCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>

                    <!-- ===== Subtasks (dependencies) ===== -->
                    <TextBlock Style="{StaticResource Label}" Margin="0,18,0,4" Text="{Binding SubtasksHeader}"
                               ToolTip="Cards that are part of this task. Their progress fills the completion circle of this card." />
                    <ItemsControl ItemsSource="{Binding Subtasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4">
                                    <h:ProgressRing DockPanel.Dock="Left" Width="16" Height="16" Margin="1,0,8,0" VerticalAlignment="Center"
                                                    Value="{Binding Progress, Mode=OneWay}"
                                                    ProgressBrush="{DynamicResource Brush.Primary}"
                                                    TrackBrush="{DynamicResource Brush.TextMuted}"
                                                    CompleteBrush="{DynamicResource Brush.Success}" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="24" Height="24"
                                            ToolTip="Remove from the subtasks (the card itself is not deleted)"
                                            Command="{Binding DataContext.RemoveSubtaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" />
                                    </Button>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="{Binding Info}" Margin="8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Create" Command="{Binding AddNewSubtaskCommand}" Margin="6,0,0,0"
                                MinWidth="64" ToolTip="Create a new card as subtask (in the same column, when you save)" />
                        <TextBox Text="{Binding NewSubtaskTitle, UpdateSourceTrigger=PropertyChanged}" ToolTip="Title of a new subtask (Enter to add)">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddNewSubtaskCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0" Visibility="{Binding HasSubtaskCandidates, Converter={StaticResource BoolToVis}}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Link" Command="{Binding AddExistingSubtaskCommand}" Margin="6,0,0,0"
                                MinWidth="64" ToolTip="Make the selected card a subtask of this one" />
                        <ComboBox ItemsSource="{Binding SubtaskCandidates}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}" ToolTip="Existing cards" />
                    </DockPanel>

                    <!-- ===== References (documents linked to this task) ===== -->
                    <DockPanel Margin="0,18,0,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Padding="6,1" IsTabStop="False" Focusable="False" Content="Link a document…"
                                Command="{Binding AddReferenceCommand}" />
                        <TextBlock Style="{StaticResource Label}" Margin="0" Text="{Binding ReferencesHeader}" VerticalAlignment="Center"
                                   ToolTip="Documents of the Documentation area linked to this task. They are listed on the card and open with a click." />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding References}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4">
                                    <Path DockPanel.Dock="Left" Data="M3.5,1.5 L9,1.5 L12.5,5 L12.5,12.5 L3.5,12.5 Z M9,1.5 L9,5 L12.5,5"
                                          Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.2" StrokeLineJoin="Round"
                                          Width="16" Height="14" Margin="0,1,6,0" VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="24" Height="24"
                                            ToolTip="Remove the link (the document itself is not deleted)"
                                            Command="{Binding DataContext.RemoveReferenceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" />
                                    </Button>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="{Binding Detail}" Margin="8,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                    <TextBlock x:Name="RefTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                        <Setter TargetName="RefTitle" Property="TextDecorations" Value="Strikethrough" />
                                        <Setter TargetName="RefTitle" Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Muted}" Text="No documents linked." 
                               Visibility="{Binding HasReferences, Converter={StaticResource InvBoolToVis}}" />

                    <!-- ===== Comments ===== -->
                    <TextBlock Style="{StaticResource Label}" Margin="0,18,0,6" Text="{Binding CommentsHeader}" />
                    <ItemsControl ItemsSource="{Binding Comments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,10">
                                    <h:Avatar DockPanel.Dock="Left" Initials="{Binding Initials}" Color="{Binding Color}" Image="{Binding Image}" Size="28"
                                              VerticalAlignment="Top" Margin="0,2,10,0" />
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="22" Height="22" ToolTip="Delete comment"
                                                    Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.DeleteCommentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="11" />
                                            </Button>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding AuthorName}" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource Muted}" Text="{Binding When}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock TextWrapping="Wrap" Margin="0,2,0,0" h:Markdown.Text="{Binding Text}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,2,0,8">
                        <h:Avatar DockPanel.Dock="Left" Initials="{Binding CurrentUserInitials}" Color="{Binding CurrentUserColor}" Image="{Binding CurrentUserImage}" Size="28"
                                  VerticalAlignment="Top" Margin="0,2,10,0" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Post" Command="{Binding PostCommentCommand}"
                                Margin="6,0,0,0" VerticalAlignment="Top" />
                        <TextBox Text="{Binding NewCommentText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="48" MaxHeight="120" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 ToolTip="Write a comment (markdown supported)" />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ===================== Side column ===================== -->
            <ScrollViewer Focusable="False" Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="Column" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Columns}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedColumn, Mode=TwoWay}" />

                    <TextBlock Style="{StaticResource Label}" Text="Priority" />
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="8" CornerRadius="2" Margin="0,0,6,0"
                                Background="{Binding PriorityColor, Converter={StaticResource HexToBrush}}" />
                        <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority, Mode=TwoWay}" />
                    </DockPanel>

                    <TextBlock Style="{StaticResource Label}" Text="Assignee" />
                    <ComboBox ItemsSource="{Binding AssigneeOptions}" SelectedItem="{Binding SelectedAssignee, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <h:Avatar Initials="{Binding Initials}" Color="{Binding Color}" Image="{Binding Image}" Size="20" />
                                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Style="{StaticResource Label}" Text="Subtask of"
                               ToolTip="Dependency: makes this card part of another task" />
                    <ComboBox ItemsSource="{Binding ParentOptions}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedParent, Mode=TwoWay}" />

                    <TextBlock Style="{StaticResource Label}" Text="Due date" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Command="{Binding ClearDueCommand}" ToolTip="Remove the due date"
                                Visibility="{Binding HasDueDate, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" />
                        </Button>
                        <TextBox DockPanel.Dock="Right" Width="58" Margin="6,0,0,0" MaxLength="5"
                                 Text="{Binding DueTime, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Optional time, HH:mm (for example 18:30)" />
                        <DatePicker SelectedDate="{Binding DueDate, Mode=TwoWay}" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Muted}" Text="Date + optional time (HH:mm)" Margin="0,2,0,0" />

                    <TextBlock Style="{StaticResource Label}" Text="End date"
                               ToolTip="When the task was actually completed. It is filled in automatically when the card enters a 'done' column (Settings > Roadmap)." />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Command="{Binding ClearEndCommand}" ToolTip="Remove the end date"
                                Visibility="{Binding HasEndDate, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" />
                        </Button>
                        <TextBox DockPanel.Dock="Right" Width="58" Margin="6,0,0,0" MaxLength="5"
                                 Text="{Binding EndTime, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Optional time, HH:mm (for example 18:30)" />
                        <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}" VerticalContentAlignment="Center" />
                    </DockPanel>

                    <DockPanel Margin="0,12,0,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Padding="6,1" IsTabStop="False" Content="Manage…"
                                Command="{Binding ManageTagsCommand}" />
                        <TextBlock Style="{StaticResource Label}" Margin="0" Text="Tags" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding TagOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource TagToggle}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Muted}" Text="No tags defined. Use Manage… to create some."
                               TextWrapping="Wrap"
                               Visibility="{Binding HasTagOptions, Converter={StaticResource InvBoolToVis}}" />

                    <!-- ===== Roadmap dates (optional) ===== -->
                    <TextBlock Style="{StaticResource Label}" Text="Roadmap" Margin="0,14,0,2" />
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding RoadmapHint}" TextWrapping="Wrap" Margin="0,0,0,2" />
                    <TextBlock Style="{StaticResource Label}" Text="Start date" Margin="0,6,0,4"
                               ToolTip="The day the work on the task started" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Command="{Binding ClearStartCommand}" ToolTip="Remove the start date"
                                Visibility="{Binding HasStartDate, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" />
                        </Button>
                        <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Label}" Text="Finish date" Margin="0,8,0,4"
                               ToolTip="Roadmap only: replaces the due and the end date there. The task is drawn as one plain bar from start to finish, without delays." />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Command="{Binding ClearFinishCommand}" ToolTip="Remove the finish date"
                                Visibility="{Binding HasFinishDate, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" />
                        </Button>
                        <DatePicker SelectedDate="{Binding FinishDate, Mode=TwoWay}" VerticalContentAlignment="Center" />
                    </DockPanel>

                    <!-- ===== Activity log ===== -->
                    <TextBlock Style="{StaticResource Label}" Text="Activity" Margin="0,16,0,4"
                               Visibility="{Binding HasActivity, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Activity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,7">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="{Binding When}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
