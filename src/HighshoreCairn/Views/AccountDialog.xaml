<Window x:Class="HighshoreCairn.Views.AccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:HighshoreCairn.Helpers"
        Title="{Binding Title}"
        Style="{StaticResource WindowBase}"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Loaded="OnLoaded">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Btn}" Content="Cancel" IsCancel="True" MinWidth="84" Margin="0,0,8,0" />
                <Button Style="{StaticResource Btn.Primary}" Content="Save" IsDefault="True" Command="{Binding SaveCommand}" MinWidth="84" />
            </StackPanel>
        </Border>
        <StackPanel Margin="18,14,18,18">
            <StackPanel Orientation="Horizontal">
                <h:Avatar Initials="{Binding Initials}" Color="{Binding AvatarColor}" Image="{Binding AvatarImage}" Size="44" />
                <TextBlock Style="{StaticResource H2}" Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Style="{StaticResource Label}" Text="Username" />
            <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Style="{StaticResource Label}" Text="Email (optional)" />
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Style="{StaticResource Label}" Text="Avatar color" />
            <ListBox Style="{StaticResource SwatchList}" ItemsSource="{Binding Colors}"
                     SelectedItem="{Binding AvatarColor, Mode=TwoWay}" />
            <TextBox Text="{Binding AvatarColor, UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left"
                     Margin="2,6,0,0" ToolTip="Custom color as hex, e.g. #1F6F8B" />

            <TextBlock Style="{StaticResource Label}" Text="Profile picture (optional)" />
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Btn}" Content="Choose image…" Command="{Binding PickImageCommand}"
                        ToolTip="Any picture: it is cropped to a square around its center" />
                <Button Style="{StaticResource Btn.Ghost}" Content="Remove" Command="{Binding RemoveImageCommand}" Margin="6,0,0,0"
                        Visibility="{Binding HasAvatarImage, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <TextBlock Style="{StaticResource Label}" Text="{Binding PasswordLabel}" TextWrapping="Wrap" />
            <PasswordBox h:PasswordBoxHelper.Attach="True"
                         h:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay}" />

            <TextBlock Style="{StaticResource Label}" Text="Confirm password" />
            <PasswordBox h:PasswordBoxHelper.Attach="True"
                         h:PasswordBoxHelper.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay}" />

            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </DockPanel>
</Window>
