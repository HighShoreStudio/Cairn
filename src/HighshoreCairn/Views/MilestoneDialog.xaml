<Window x:Class="HighshoreCairn.Views.MilestoneDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:HighshoreCairn.Helpers"
        Title="{Binding WindowTitle}"
        Style="{StaticResource WindowBase}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <!-- A milestone of the roadmap. DataContext = MilestoneEditorViewModel. -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Btn}" Content="Cancel" IsCancel="True" MinWidth="84" Margin="0,0,8,0" />
                <Button Style="{StaticResource Btn.Primary}" Content="Save" IsDefault="True" Command="{Binding SaveCommand}" MinWidth="84" />
            </StackPanel>
        </Border>
        <StackPanel Margin="18,14,18,18">
            <TextBlock Style="{StaticResource H2}" Text="{Binding WindowTitle}" />

            <TextBlock Style="{StaticResource Label}" Text="Name *" />
            <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="For example: v1.2" />

            <TextBlock Style="{StaticResource Label}" Text="Type" />
            <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="4" Background="{Binding Color, Converter={StaticResource HexToBrush}}">
                                <h:IconView Icon="{Binding Icon}" Folder="{Binding DataContext.IconFolder, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Foreground="White" Width="15" Height="15" />
                            </Border>
                            <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource Label}" Text="Start of the work *" />
                    <DatePicker SelectedDate="{Binding Start, Mode=TwoWay}" VerticalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Label}" Text="Release *" />
                    <DatePicker SelectedDate="{Binding End, Mode=TwoWay}" VerticalContentAlignment="Center" />
                </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource Label}" Text="Note" />
            <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="64" MaxHeight="150" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                     ToolTip="Only shown here" />

            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </DockPanel>
</Window>
