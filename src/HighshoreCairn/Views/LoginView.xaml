<UserControl x:Class="HighshoreCairn.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:HighshoreCairn.Helpers"
             PreviewKeyDown="OnPreviewKeyDown"
             Loaded="OnLoaded">
    <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Brush.Background}">
        <Border Style="{StaticResource Card}" Width="420" Padding="28" Margin="20"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="CAIRN" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Link}" />
                <TextBlock Style="{StaticResource H1}" Text="{Binding Heading}" Margin="0,4,0,0" />
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Accounts are stored encrypted on this PC only. Nothing is sent online." />

                <!-- Quick pick of the accounts stored on this PC -->
                <StackPanel Visibility="{Binding IsLoginMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Label}" Text="Accounts on this PC"
                               Visibility="{Binding HasExistingAccounts, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding ExistingAccounts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Btn}" Margin="0,0,6,6" Padding="6,4"
                                        Command="{Binding DataContext.PickAccountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <h:Avatar Initials="{Binding Initials}" Color="{Binding AvatarColor}" Image="{Binding AvatarImage}" Size="22" />
                                        <TextBlock Text="{Binding Username}" Margin="6,0,2,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Style="{StaticResource Label}" Text="Username" />
                <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Style="{StaticResource Label}" Text="Password" />
                <PasswordBox x:Name="PasswordInput" h:PasswordBoxHelper.Attach="True"
                             h:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay}" />

                <!-- Extra fields when creating an account -->
                <StackPanel Visibility="{Binding IsCreateMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Label}" Text="Confirm password" />
                    <PasswordBox h:PasswordBoxHelper.Attach="True"
                                 h:PasswordBoxHelper.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay}" />

                    <TextBlock Style="{StaticResource Label}" Text="Email (optional)" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource Label}" Text="Avatar color" />
                    <ListBox Style="{StaticResource SwatchList}" ItemsSource="{Binding Colors}"
                             SelectedItem="{Binding AvatarColor, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <h:Avatar Initials="{Binding Initials}" Color="{Binding AvatarColor}" Image="{Binding AvatarImage}" Size="30" />
                        <TextBox Text="{Binding AvatarColor, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="8,0,0,0"
                                 ToolTip="Custom color as hex, e.g. #1F6F8B" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Label}" Text="Profile picture (optional)" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Btn}" Content="Choose image…" Command="{Binding PickImageCommand}"
                                ToolTip="Any picture: it is cropped to a square around its center" />
                        <Button Style="{StaticResource Btn.Ghost}" Content="Remove" Command="{Binding RemoveImageCommand}" Margin="6,0,0,0"
                                Visibility="{Binding HasAvatarImage, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                <Button Style="{StaticResource Btn.Primary}" Content="Login" Margin="0,18,0,0" Padding="12,8"
                        Command="{Binding LoginCommand}"
                        Visibility="{Binding IsLoginMode, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource Btn.Primary}" Content="Create account" Margin="0,18,0,0" Padding="12,8"
                        Command="{Binding CreateCommand}"
                        Visibility="{Binding IsCreateMode, Converter={StaticResource BoolToVis}}" />

                <Button Style="{StaticResource Btn.Link}" Content="{Binding ToggleText}" Margin="0,8,0,0"
                        Command="{Binding ToggleModeCommand}" />
                <Button Style="{StaticResource Btn.Link}" Content="Back to projects"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
