<UserControl x:Class="HighshoreCairn.Views.DocsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HighshoreCairn.ViewModels"
             xmlns:v="clr-namespace:HighshoreCairn.Views">

    <!-- Documentation area of a project. DataContext = DocsViewModel.
         Left: the tree of the docs folder. Center: the open document (tabs), floating windows, or the graph.
         Right (optional): outline, backlinks and statistics of the active document. -->

    <UserControl.Resources>
        <Style x:Key="Bar" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Small icon drawn with lines (16 x 16) -->
        <Style x:Key="MiniIcon" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stroke" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="StrokeThickness" Value="1.3" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>

        <!-- Tab of an open document -->
        <Style x:Key="DocTab" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Padding" Value="10,5,4,4" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Row of the tree: highlighted while something is dragged over it -->
        <Style x:Key="TreeRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="1,2,6,2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.AccentLight}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Picture of a tree row, by kind: a filled folder, a sheet with lines (markdown), a sheet with an "A"
             (rich text), a plain sheet with lines (text), a framed landscape (picture), an empty sheet (other files). -->
        <Style x:Key="TreeIcon" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="StrokeThickness" Value="1.2" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="Stroke" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="Data" Value="M3.5,1.5 L9.5,1.5 L12.5,4.5 L12.5,14.5 L3.5,14.5 Z M9.5,1.5 L9.5,4.5 L12.5,4.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IconKind}" Value="folder">
                    <Setter Property="Data" Value="M1.5,3.5 L6.3,3.5 L7.8,5.3 L14.5,5.3 L14.5,13 L1.5,13 Z" />
                    <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="Stroke" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IconKind}" Value="markdown">
                    <Setter Property="Data" Value="M3.5,1.5 L9.5,1.5 L12.5,4.5 L12.5,14.5 L3.5,14.5 Z M9.5,1.5 L9.5,4.5 L12.5,4.5 M5.5,7.5 L10.5,7.5 M5.5,9.8 L10.5,9.8 M5.5,12.1 L8.5,12.1" />
                    <Setter Property="Stroke" Value="{DynamicResource Brush.Primary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IconKind}" Value="text">
                    <Setter Property="Data" Value="M3.5,1.5 L9.5,1.5 L12.5,4.5 L12.5,14.5 L3.5,14.5 Z M9.5,1.5 L9.5,4.5 L12.5,4.5 M5.5,7.5 L10.5,7.5 M5.5,9.8 L10.5,9.8 M5.5,12.1 L8.5,12.1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IconKind}" Value="rich">
                    <Setter Property="Data" Value="M3.5,1.5 L9.5,1.5 L12.5,4.5 L12.5,14.5 L3.5,14.5 Z M9.5,1.5 L9.5,4.5 L12.5,4.5 M5.5,12.5 L8,6.8 L10.5,12.5 M6.4,10.6 L9.6,10.6" />
                    <Setter Property="Stroke" Value="#A26BDB" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IconKind}" Value="image">
                    <Setter Property="Data" Value="M2,3 L14,3 L14,13 L2,13 Z M2,11.2 L5.8,7.6 L8.4,10.2 L10.4,8.4 L14,11.6 M10.2,5.8 L10.9,5.8" />
                    <Setter Property="Stroke" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TreeName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBroken}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                    <Setter Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="TreeColumn" Width="270" MinWidth="180" MaxWidth="520" />
            <ColumnDefinition x:Name="SplitterColumn" Width="8" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Tree of documents ===================== -->
        <Border Grid.Column="0" Style="{StaticResource Card}"
                Visibility="{Binding IsTreeVisible, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="8,8,8,4">
                    <WrapPanel>
                        <!-- New: opens a small menu with the two kinds of document -->
                        <Button Style="{StaticResource Bar}" Content="New ▾" Click="New_Click" ToolTip="New document: markdown or rich text" Margin="0,0,4,4">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Document" Click="New_Document" ToolTip="A markdown document (.md): plain text with formatting, links between documents, templates">
                                        <MenuItem.Icon>
                                            <Path Width="16" Height="16" Stroke="{DynamicResource Brush.Primary}" StrokeThickness="1.2" StrokeLineJoin="Round"
                                                  Data="M3.5,1.5 L9.5,1.5 L12.5,4.5 L12.5,14.5 L3.5,14.5 Z M9.5,1.5 L9.5,4.5 L12.5,4.5 M5.5,7.5 L10.5,7.5 M5.5,9.8 L10.5,9.8 M5.5,12.1 L8.5,12.1" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Rich Text" Click="New_RichText" ToolTip="A rich text document (.rtf): fonts, sizes, colors, alignment; opens in Word and WordPad too">
                                        <MenuItem.Icon>
                                            <Path Width="16" Height="16" Stroke="#A26BDB" StrokeThickness="1.2" StrokeLineJoin="Round"
                                                  Data="M3.5,1.5 L9.5,1.5 L12.5,4.5 L12.5,14.5 L3.5,14.5 Z M9.5,1.5 L9.5,4.5 L12.5,4.5 M5.5,12.5 L8,6.8 L10.5,12.5 M6.4,10.6 L9.6,10.6" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource Bar}" Content="Folder" Command="{Binding NewFolderCommand}" ToolTip="New folder" Margin="0,0,4,4" />
                        <Button Style="{StaticResource Bar}" Content="Import…" Command="{Binding ImportCommand}" Margin="0,0,4,4"
                                ToolTip="Add external files (copied or linked, see Settings > Documentation). You can also drop files here." />
                        <Button Style="{StaticResource Bar}" Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,0,4"
                                ToolTip="Read the docs folder again (after changes made outside the app)" />
                    </WrapPanel>
                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Brush.Input}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Padding="5,3" Focusable="False"
                                    Command="{Binding ClearSearchCommand}" ToolTip="Clear the search"
                                    Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
                                <Path Style="{StaticResource MiniIcon}" Data="M4,4 L12,12 M12,4 L4,12" />
                            </Button>
                            <Grid>
                                <TextBox BorderThickness="0" Background="Transparent" x:Name="SearchBox"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                         ToolTip="Search in the names and in the text of the documents" />
                                <TextBlock Text="Search the documents…" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="10,5">
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                </Border>

                <Grid Margin="4,2,4,4" AllowDrop="True" Background="Transparent" x:Name="TreeArea"
                      DragOver="Tree_DragOver" DragLeave="Tree_DragLeave" Drop="Tree_Drop">

                    <!-- The tree mirrors the docs folder -->
                    <TreeView x:Name="Tree" ItemsSource="{Binding Nodes}"
                              SelectedItemChanged="Tree_SelectedItemChanged"
                              PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown" PreviewMouseMove="Tree_PreviewMouseMove"
                              MouseDoubleClick="Tree_MouseDoubleClick" KeyDown="Tree_KeyDown"
                              PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsBrowsing, Converter={StaticResource BoolToVis}}">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:DocNodeViewModel}" ItemsSource="{Binding Children}">
                                <Border Style="{StaticResource TreeRow}" ToolTip="{Binding ToolTip}" ToolTipService.InitialShowDelay="800">
                                    <Border.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Open" FontWeight="SemiBold" Click="Menu_Open" />
                                            <MenuItem Header="Open in a window" Click="Menu_OpenInWindow" />
                                            <MenuItem Header="Open with the default application" Click="Menu_OpenExternal" />
                                            <Separator />
                                            <MenuItem Header="New document here…" Click="Menu_NewDocument" />
                                            <MenuItem Header="New rich text here…" Click="Menu_NewRichDocument" />
                                            <MenuItem Header="New folder here…" Click="Menu_NewFolder" />
                                            <Separator />
                                            <MenuItem Header="Rename…" Click="Menu_Rename" InputGestureText="F2" />
                                            <MenuItem Header="Show in Explorer" Click="Menu_Reveal" />
                                            <Separator />
                                            <MenuItem Header="Delete…" Click="Menu_Delete" InputGestureText="Del" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource TreeIcon}" />
                                        <TextBlock Style="{StaticResource TreeName}" Text="{Binding Name}" VerticalAlignment="Center" />
                                        <Path Data="M4,12 L12,4 M6.5,4 L12,4 L12,9.5" Width="16" Height="16" Margin="5,0,0,0" VerticalAlignment="Center"
                                              Stroke="{DynamicResource Brush.Link}" StrokeThickness="1.4" StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" ToolTip="Linked file (lives outside the project)"
                                              Visibility="{Binding IsLink, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- Empty documentation -->
                    <StackPanel VerticalAlignment="Center" Margin="14" IsHitTestVisible="False"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"
                                   Text="No documents yet. Create one with New, or drop files here." />
                    </StackPanel>

                    <!-- Search results -->
                    <DockPanel Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" Background="{DynamicResource Brush.Surface}">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Text="{Binding SearchSummary}" Margin="6,2,6,4" />
                        <ListBox ItemsSource="{Binding SearchResults}" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Search_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding Snippet}" TextWrapping="Wrap" MaxHeight="34" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" Focusable="False"
                      Visibility="{Binding IsTreeVisible, Converter={StaticResource BoolToVis}}" />

        <!-- ===================== Workspace ===================== -->
        <Border Grid.Column="2" Style="{StaticResource Card}" ClipToBounds="True">
            <DockPanel>

                <!-- Tabs of the open documents + view buttons -->
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="6,4,6,0">
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Left" Style="{StaticResource ToolToggle}" Width="Auto" Height="26" Padding="10,0" Margin="0,0,8,4"
                                      Content="Files" IsChecked="{Binding IsTreeVisible, Mode=TwoWay}"
                                      ToolTip="Show or hide the list of documents: hidden, the document uses the whole area" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,4">
                            <ToggleButton Style="{StaticResource ToolToggle}" Width="Auto" Height="26" Padding="10,0" Content="Graph"
                                          IsChecked="{Binding IsGraphVisible, Mode=TwoWay}"
                                          ToolTip="Graph of the documents: the ones that reference each other are connected" />
                            <ToggleButton Style="{StaticResource ToolToggle}" Width="Auto" Height="26" Padding="10,0" Content="Info"
                                          IsChecked="{Binding IsInfoVisible, Mode=TwoWay}"
                                          ToolTip="Outline, backlinks and statistics of the open document" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DocTab}" MouseLeftButtonDown="Tab_MouseLeftButtonDown" MouseDown="Tab_MouseDown"
                                            ToolTip="{Binding ToolTip}" ToolTipService.InitialShowDelay="800">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Header}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                            <Button Style="{StaticResource Btn.Ghost}" Padding="3,2" Margin="6,0,0,0" Focusable="False"
                                                    Command="{Binding FloatCommand}" ToolTip="Open in a small window">
                                                <Path Style="{StaticResource MiniIcon}" Data="M2.5,5.5 L2.5,13.5 L10.5,13.5 L10.5,5.5 Z M5.5,5.5 L5.5,2.5 L13.5,2.5 L13.5,10.5 L10.5,10.5" />
                                            </Button>
                                            <Button Style="{StaticResource Btn.Ghost}" Padding="3,2" Focusable="False"
                                                    Command="{Binding CloseCommand}" ToolTip="Close (the document is saved)">
                                                <Path Style="{StaticResource MiniIcon}" Data="M4,4 L12,12 M12,4 L4,12" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <Grid x:Name="Workspace" SizeChanged="Workspace_SizeChanged" AllowDrop="True" DragOver="Workspace_DragOver" Drop="Workspace_Drop"
                      Background="Transparent">

                    <!-- Nothing open -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460"
                                Visibility="{Binding IsWorkspaceEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource H2}" Text="Documentation" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,14"
                                   Text="Double-click a document to open it full size, or right-click > Open in a window to keep it in a small window you can move and resize. Documents are markdown files in the docs folder of the project." />
                        <Button Style="{StaticResource Btn.Primary}" Content="New document" Command="{Binding NewDocumentCommand}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Full-size documents: one editor per tab, only the active one is visible -->
                    <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False"
                                  Visibility="{Binding IsEditorVisible, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <v:DocEditor Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Graph of the references between documents -->
                    <Grid Visibility="{Binding IsGraphVisible, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <v:GraphView x:Name="Graph" Grid.Column="0" Graph="{Binding Graph}" SelectedId="{Binding GraphNodeId, Mode=OneWay}" />
                        <TextBlock Grid.Column="0" Style="{StaticResource Muted}" Text="{Binding GraphSummary}" Margin="12,10"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
                        <TextBlock Grid.Column="0" Style="{StaticResource Muted}" Margin="12,10" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                   IsHitTestVisible="False"
                                   Text="Click a node to preview it · double-click to open · wheel to zoom · drag to move" />
                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                            <Button Style="{StaticResource Bar}" Content="−" Padding="9,4" Click="Graph_ZoomOut" ToolTip="Zoom out" />
                            <Button Style="{StaticResource Bar}" Content="+" Padding="9,4" Click="Graph_ZoomIn" ToolTip="Zoom in" />
                            <Button Style="{StaticResource Bar}" Content="Fit" Click="Graph_Fit" ToolTip="Show the whole graph" />
                        </StackPanel>

                        <!-- Preview of the clicked node -->
                        <Border Grid.Column="1" Width="360" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0"
                                Background="{DynamicResource Brush.Surface}"
                                Visibility="{Binding HasGraphSelection, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="14,12,14,8">
                                    <TextBlock Style="{StaticResource H2}" Text="{Binding GraphTitle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding GraphInfo}" TextWrapping="Wrap" Margin="0,2,0,8" />
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsGraphDocument, Converter={StaticResource BoolToVis}}">
                                        <Button Style="{StaticResource Bar}" Content="Open" Command="{Binding GraphOpenCommand}" />
                                        <Button Style="{StaticResource Bar}" Content="Open in a window" Command="{Binding GraphOpenInWindowCommand}" />
                                    </StackPanel>
                                    <Button Style="{StaticResource Bar}" Content="Create this document" Command="{Binding GraphCreateCommand}" HorizontalAlignment="Left"
                                            Visibility="{Binding IsGraphGhost, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                                    <FlowDocumentScrollViewer x:Name="GraphPreview" VerticalScrollBarVisibility="Auto" Focusable="False"
                                                              Foreground="{DynamicResource Brush.Text}" Padding="14,10" />
                                </Border>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Floating windows: small editors that can be moved and resized over the workspace -->
                    <ItemsControl ItemsSource="{Binding Windows}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas ClipToBounds="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DocWindowViewModel}">
                                <Grid Width="{Binding Width}" Height="{Binding Height}" PreviewMouseDown="Window_PreviewMouseDown">
                                    <!-- shadow (kept on its own element so the text above stays sharp) -->
                                    <Border CornerRadius="8" Background="{DynamicResource Brush.Surface}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.3" />
                                        </Border.Effect>
                                    </Border>
                                    <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Brush.Primary}"
                                            Background="{DynamicResource Brush.Surface}" ClipToBounds="True">
                                        <DockPanel>
                                            <!-- title bar: drag it to move the window -->
                                            <Grid DockPanel.Dock="Top" Height="30" Background="{DynamicResource Brush.PrimaryLight}">
                                                <Thumb DragDelta="Window_Move" Cursor="SizeAll">
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="Transparent" />
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                                <DockPanel IsHitTestVisible="True">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Padding="7,4" Focusable="False"
                                                            Command="{Binding CloseCommand}" ToolTip="Close (the document is saved)">
                                                        <Path Style="{StaticResource MiniIcon}" Data="M4,4 L12,12 M12,4 L4,12" />
                                                    </Button>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Padding="7,4" Focusable="False"
                                                            Command="{Binding DockCommand}" ToolTip="Enlarge to the whole workspace">
                                                        <Path Style="{StaticResource MiniIcon}" Data="M2.5,2.5 L13.5,2.5 L13.5,13.5 L2.5,13.5 Z M2.5,5.5 L13.5,5.5" />
                                                    </Button>
                                                    <TextBlock Text="{Binding Document.Header}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0"
                                                               TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                                                </DockPanel>
                                            </Grid>
                                            <v:DocEditor DataContext="{Binding Document}" />
                                        </DockPanel>
                                    </Border>
                                    <!-- resize handle -->
                                    <Thumb Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"
                                           DragDelta="Window_Resize" ToolTip="Drag to resize">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Path Data="M4,14 L14,4 M8,14 L14,8 M12,14 L14,12" Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.2" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ===================== Info panel ===================== -->
        <Border Grid.Column="3" Style="{StaticResource Card}" Width="250" Margin="8,0,0,0"
                Visibility="{Binding IsInfoVisible, Converter={StaticResource BoolToVis}}">
            <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" DataContext="{Binding InfoDocument}">
                <StackPanel Margin="12,10,12,12">
                    <TextBlock Style="{StaticResource H2}" Text="{Binding Title, FallbackValue='No document open'}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding StatsText}" TextWrapping="Wrap" Margin="0,2,0,0" />

                    <TextBlock Style="{StaticResource Label}" Text="OUTLINE" />
                    <TextBlock Style="{StaticResource Muted}" Text="No headings"
                               Visibility="{Binding HasOutline, Converter={StaticResource InvBoolToVis}, FallbackValue=Collapsed}" />
                    <ItemsControl ItemsSource="{Binding Outline}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Btn.Link}" HorizontalContentAlignment="Left" Padding="2,2" Focusable="False"
                                        Command="{Binding DataContext.GoToHeadingCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding Indented}" TextTrimming="CharacterEllipsis" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Label}" Text="LINKED FROM" />
                    <TextBlock Style="{StaticResource Muted}" Text="No other document links here"
                               Visibility="{Binding HasBacklinks, Converter={StaticResource InvBoolToVis}, FallbackValue=Collapsed}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Backlinks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Btn.Link}" HorizontalContentAlignment="Left" Padding="2,2" Focusable="False"
                                        Command="{Binding DataContext.Owner.OpenBacklinkCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                        CommandParameter="{Binding}" ToolTip="{Binding Path}">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
