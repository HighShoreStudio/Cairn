<Window x:Class="HighshoreCairn.Views.RoadmapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:HighshoreCairn.Helpers"
        xmlns:v="clr-namespace:HighshoreCairn.Views"
        Title="{Binding WindowTitle}"
        Style="{StaticResource WindowBase}"
        Width="1180" Height="680" MinWidth="780" MinHeight="420"
        Icon="/Assets/app.ico">

    <!-- The roadmap of a project, in its own window (not modal: it can stay open next to the board).
         DataContext = RoadmapViewModel. The chart itself is drawn by the RoadmapView control. -->

    <Window.Resources>
        <Style x:Key="Bar" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Arrow" TargetType="Button" BasedOn="{StaticResource Btn.Icon}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel Background="{DynamicResource Brush.Background}">

        <!-- ===================== Tool bar ===================== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="10,10,10,8" Padding="8,6">
            <h:CenteredHeaderPanel Gap="14">

                <!-- 1. The period: months on screen, the arrows, Today, Free View -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Muted}" Text="Months" VerticalAlignment="Center" Margin="2,0,6,0" />
                    <Button Style="{StaticResource Arrow}" Width="22" Command="{Binding MonthsDownCommand}" ToolTip="One month less"
                            IsEnabled="{Binding IsMonthView}">
                        <Path Data="M4,8 L12,8" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.6" Width="16" Height="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                    <TextBox Width="34" TextAlignment="Center" MaxLength="2" VerticalAlignment="Center" Padding="2,3"
                             Text="{Binding Months, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsMonthView}"
                             ToolTip="How many months the timeline shows (1-12)" />
                    <Button Style="{StaticResource Arrow}" Width="22" Command="{Binding MonthsUpCommand}" ToolTip="One month more"
                            IsEnabled="{Binding IsMonthView}">
                        <Path Data="M4,8 L12,8 M8,4 L8,12" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.6" Width="16" Height="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>

                    <Border Width="1" Height="20" Background="{DynamicResource Brush.Border}" Margin="10,0,8,0" />

                    <Button Style="{StaticResource Arrow}" Command="{Binding PreviousCommand}" IsEnabled="{Binding IsMonthView}" ToolTip="One month earlier (from January: the previous year)">
                        <Path Data="M10,3.5 L5.5,8 L10,12.5" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.7" Width="16" Height="16"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Button>
                    <TextBlock Text="{Binding RangeLabel}" FontWeight="SemiBold" FontSize="14" MinWidth="124" TextAlignment="Center"
                               VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}" Margin="2,0" />
                    <Button Style="{StaticResource Arrow}" Command="{Binding NextCommand}" IsEnabled="{Binding IsMonthView}" ToolTip="One month later (from December: the next year)">
                        <Path Data="M6,3.5 L10.5,8 L6,12.5" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.7" Width="16" Height="16"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Button>

                    <Button Style="{StaticResource Bar}" Content="Today" Command="{Binding TodayCommand}" Margin="8,0,6,0"
                            ToolTip="Back to the current month, as far to the left as possible" />
                    <Border Style="{StaticResource Card}" CornerRadius="7" Padding="1" VerticalAlignment="Center">
                        <ToggleButton Style="{StaticResource ToolToggle}" Width="Auto" Height="24" Padding="10,0" Margin="0" Content="Free View"
                                      IsChecked="{Binding IsFreeView, Mode=TwoWay}"
                                      ToolTip="Free view: wheel = zoom (one week to two years), middle button drag = move, arrows / Shift+arrows = move slowly / fast" />
                    </Border>
                </StackPanel>

                <!-- 2. The date under the mouse, in the middle of the window -->
                <TextBlock Text="{Binding HoverText}" FontSize="15" FontWeight="SemiBold" FontFamily="Consolas, Courier New"
                           Foreground="{DynamicResource Brush.Primary}" VerticalAlignment="Center" MinWidth="10" />

                <!-- 3. What can be created here -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Bar}" Content="{Binding AddMilestoneText}" Command="{Binding AddMilestoneCommand}"
                            ToolTip="New milestone: the period from the start of the work to the release"
                            Visibility="{Binding ShowMilestones, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource Bar}" Content="{Binding AddCustomText}" Command="{Binding AddCustomCommand}"
                            ToolTip="New task that exists only in the roadmap"
                            Visibility="{Binding ShowCustom, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource Bar}" Content="Settings" Command="{Binding SettingsCommand}" Margin="0"
                            ToolTip="Rows, colors and milestone types (Project settings > Roadmap)" />
                </StackPanel>
            </h:CenteredHeaderPanel>
        </Border>

        <!-- ===================== Status ===================== -->
        <DockPanel DockPanel.Dock="Bottom" Margin="12,6,12,8">
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="{Binding Summary}" Margin="12,0,0,0" />
            <TextBlock Style="{StaticResource Muted}" Text="{Binding SelectionText}" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" />
            <TextBlock Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                       Text="Click = select · double click = open · right click = menu · eye = close a row · drag a tag row to reorder"
                       Visibility="{Binding HasSelection, Converter={StaticResource InvBoolToVis}}" />
        </DockPanel>

        <!-- ===================== The chart ===================== -->
        <Border Margin="10,0,10,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <v:RoadmapView x:Name="Chart" />
        </Border>
    </DockPanel>
</Window>
