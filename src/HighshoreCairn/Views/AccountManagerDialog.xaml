<Window x:Class="HighshoreCairn.Views.AccountManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:HighshoreCairn.Helpers"
        Title="Accounts on this PC"
        Style="{StaticResource WindowBase}"
        Width="560" Height="480" MinWidth="460" MinHeight="340"
        ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" Content="Close" IsCancel="True" MinWidth="84" />
                <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                           Text="Accounts are stored encrypted in %APPDATA%\Cairn\accounts.json" />
            </DockPanel>
        </Border>

        <DockPanel Margin="16,14,16,10">
            <StackPanel DockPanel.Dock="Right" Width="130" Margin="12,0,0,0">
                <Button Style="{StaticResource Btn.Primary}" Content="New account" Command="{Binding AddCommand}" Margin="0,0,0,6" />
                <Button Style="{StaticResource Btn}" Content="Edit" Command="{Binding EditCommand}"
                        IsEnabled="{Binding HasSelection}" Margin="0,0,0,6" />
                <Button Style="{StaticResource Btn}" Content="Switch to" Command="{Binding SwitchCommand}"
                        IsEnabled="{Binding HasSelection}" Margin="0,0,0,6" ToolTip="Login as the selected account" />
                <Button Style="{StaticResource Btn.Danger}" Content="Delete" Command="{Binding DeleteCommand}"
                        IsEnabled="{Binding HasSelection}" />
            </StackPanel>

            <ListBox Style="{StaticResource RowList}" ItemsSource="{Binding Items}"
                     SelectedItem="{Binding Selected, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <h:Avatar DockPanel.Dock="Left" Initials="{Binding Initials}" Color="{Binding AvatarColor}" Image="{Binding AvatarImage}" Size="34"
                                      Margin="0,0,10,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Username}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding Details}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DockPanel>
</Window>
