<Window x:Class="HighshoreCairn.Views.TagManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tags"
        Style="{StaticResource WindowBase}"
        Width="560" Height="440" MinWidth="480" MinHeight="360"
        ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource Btn}" Content="Cancel" IsCancel="True" MinWidth="84" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Btn.Primary}" Content="Save" Command="{Binding SaveCommand}" MinWidth="84" />
                </StackPanel>
                <TextBlock Foreground="{DynamicResource Brush.Danger}" Text="{Binding Error}" VerticalAlignment="Center" TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
            </DockPanel>
        </Border>

        <Grid Margin="16,14,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Tag list -->
            <DockPanel Grid.Column="0">
                <Button DockPanel.Dock="Bottom" Style="{StaticResource Btn}" Content="Add tag" Command="{Binding AddCommand}" Margin="0,8,0,0" />
                <ListBox Style="{StaticResource RowList}" ItemsSource="{Binding Tags}" SelectedItem="{Binding Selected, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="9,2" HorizontalAlignment="Left"
                                    Background="{Binding Color, Converter={StaticResource HexToBrush}}">
                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Selected tag editor -->
            <StackPanel Grid.Column="2" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Text="Name" />
                <TextBox Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Style="{StaticResource Label}" Text="Color" />
                <ListBox Style="{StaticResource SwatchList}" ItemsSource="{Binding Colors}"
                         SelectedItem="{Binding Selected.Color, Mode=TwoWay}" />
                <TextBox Text="{Binding Selected.Color, UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left"
                         Margin="2,6,0,0" ToolTip="Custom color as hex, e.g. #E5484D" />

                <Button Style="{StaticResource Btn.Danger}" Content="Delete this tag" Command="{Binding RemoveCommand}"
                        CommandParameter="{Binding Selected}" HorizontalAlignment="Left" Margin="0,18,0,0" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
