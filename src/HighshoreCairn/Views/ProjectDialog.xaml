<Window x:Class="HighshoreCairn.Views.ProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:HighshoreCairn.Helpers"
        Title="New Project"
        Style="{StaticResource WindowBase}"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Btn}" Content="Cancel" IsCancel="True" MinWidth="84" Margin="0,0,8,0" />
                <Button Style="{StaticResource Btn.Primary}" Content="Create" IsDefault="True" Command="{Binding CreateCommand}" MinWidth="84" />
            </StackPanel>
        </Border>
        <StackPanel Margin="18,14,18,18">
            <TextBlock Style="{StaticResource H2}" Text="New Project" />

            <TextBlock Style="{StaticResource Label}" Text="Name *" />
            <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Style="{StaticResource Label}" Text="Description" />
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                     Height="64" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />

            <TextBlock Style="{StaticResource Label}" Text="Color" />
            <ListBox Style="{StaticResource SwatchList}" ItemsSource="{Binding Colors}"
                     SelectedItem="{Binding Color, Mode=TwoWay}" />

            <TextBlock Style="{StaticResource Label}" Text="Icon (optional)" />
            <StackPanel Orientation="Horizontal">
                <h:Avatar Square="True" Size="40" Initials="{Binding Initials}" Color="{Binding Color}" Image="{Binding Icon}" Margin="0,0,10,0" />
                <Button Style="{StaticResource Btn}" Content="Choose image…" Command="{Binding PickIconCommand}" VerticalAlignment="Center"
                        ToolTip="Any picture: it is cropped to a square around its center" />
                <Button Style="{StaticResource Btn.Ghost}" Content="Remove" Command="{Binding RemoveIconCommand}" Margin="6,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <TextBlock Style="{StaticResource Label}" Text="Folder" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Content="Default" Command="{Binding ResetFolderCommand}"
                        ToolTip="Use the default folder in %APPDATA%\Cairn\projects" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Browse…" Command="{Binding BrowseCommand}" Margin="6,0,2,0" />
                <TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="The project is saved as JSON files in this folder (project.json, kanban.json, accounts.json, backups). You can put it under git." />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding TemplateNote}"
                       Foreground="{DynamicResource Brush.Link}"
                       Visibility="{Binding HasTemplateNote, Converter={StaticResource BoolToVis}}" />

            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </DockPanel>
</Window>
