<Window x:Class="HighshoreCairn.Views.IconPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:HighshoreCairn.Helpers"
        Title="Choose an icon"
        Style="{StaticResource WindowBase}"
        Width="620" Height="560" MinWidth="460" MinHeight="380"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=FilterBox}">
    <!-- Picks the icon of a milestone type: a built-in icon or a file. DataContext = IconPickerViewModel. -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource Btn}" Content="Use a file…" Command="{Binding BrowseCommand}"
                        Visibility="{Binding CanBrowse, Converter={StaticResource BoolToVis}}"
                        ToolTip="A picture (png, jpg, bmp, gif) or a simple one-color SVG. It is copied into the roadmap-icons folder of the project." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Btn}" Content="Cancel" IsCancel="True" MinWidth="84" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Btn.Primary}" Content="Choose" IsDefault="True" Command="{Binding OkCommand}" MinWidth="84" />
                </StackPanel>
            </DockPanel>
        </Border>
        <DockPanel Margin="18,14,18,12">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource H2}" Text="Choose an icon" />
            <DockPanel DockPanel.Dock="Top" Margin="0,10,0,8">
                <ComboBox DockPanel.Dock="Right" Width="110" Margin="8,0,0,0" ItemsSource="{Binding Variants}"
                          SelectedItem="{Binding Variant, Mode=TwoWay}" ToolTip="Style of the icons" />
                <TextBox x:Name="FilterBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                         ToolTip="Type to search: rocket, flag, bug, star, cube, flask…" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Text="{Binding Summary}" Margin="0,6,0,0" />
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}" MouseDoubleClick="List_MouseDoubleClick"
                     BorderBrush="{DynamicResource Brush.Border}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="ToolTip" Value="{Binding Name}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Width="46" Height="46" Margin="2" CornerRadius="6" Background="Transparent"
                                            BorderThickness="2" BorderBrush="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PrimaryLight}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <h:IconView Icon="{Binding Key}" Width="26" Height="26" Foreground="{DynamicResource Brush.Text}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DockPanel>
</Window>
