<Window x:Class="HighshoreCairn.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HighshoreCairn.ViewModels"
        xmlns:v="clr-namespace:HighshoreCairn.Views"
        xmlns:h="clr-namespace:HighshoreCairn.Helpers"
        Title="{Binding WindowTitle}"
        Style="{StaticResource WindowBase}"
        Icon="/Assets/app.ico"
        Width="1280" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- The current screen is a ViewModel: these templates pick the matching View. -->
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <v:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectListViewModel}">
            <v:ProjectListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BoardViewModel}">
            <v:BoardView />
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewProjectCommand}" />
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding OpenFolderCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <!-- ===== Top bar: menu on the left, account + settings on the right ===== -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <DockPanel Height="40">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,8,0">
                    <Menu Background="Transparent" VerticalAlignment="Center"
                          Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
                        <MenuItem Padding="6,4">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <h:Avatar Initials="{Binding AccountInitials}" Color="{Binding AccountColor}" Image="{Binding AccountImage}" Size="24" />
                                    <TextBlock Text="{Binding AccountName}" Margin="8,0,6,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="9" />
                                </StackPanel>
                            </MenuItem.Header>
                            <MenuItem Header="Edit _Profile…" Command="{Binding EditProfileCommand}" />
                            <MenuItem Header="_Switch Account…" Command="{Binding SwitchAccountCommand}" />
                            <MenuItem Header="_Manage Accounts…" Command="{Binding ManageAccountsCommand}" />
                            <Separator />
                            <MenuItem Header="_Logout" Command="{Binding LogoutCommand}" />
                        </MenuItem>
                    </Menu>
                    <Button Style="{StaticResource Btn.Icon}" Command="{Binding ToggleThemeCommand}"
                            ToolTip="{Binding ThemeToolTip}" Margin="4,0,0,0">
                        <Grid>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE708;"
                                       Visibility="{Binding IsDarkMode, Converter={StaticResource InvBoolToVis}}" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE706;"
                                       Visibility="{Binding IsDarkMode, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource Btn.Icon}" Command="{Binding ProjectSettingsCommand}"
                            IsEnabled="{Binding HasBoard}" ToolTip="Project settings" Margin="4,0,0,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" />
                    </Button>
                    <Button Style="{StaticResource Btn.Icon}" Command="{Binding AboutCommand}" ToolTip="About">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" />
                    </Button>
                </StackPanel>

                <!-- App name: only on the main menu (the list of projects) -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,6,0"
                            Visibility="{Binding IsProjectList, Converter={StaticResource BoolToVis}}">
                    <Image Source="/Assets/app.ico" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="CAIRN" FontSize="15" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.PrimaryDark}" />
                </StackPanel>

                <Menu Background="Transparent" VerticalAlignment="Center" Margin="6,0,0,0">
                    <MenuItem Header="_File">
                        <MenuItem Header="_New Project…" Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+N"
                                  IsEnabled="{Binding IsLoggedIn}" />
                        <MenuItem Header="_Open Project Folder…" Command="{Binding OpenFolderCommand}" InputGestureText="Ctrl+O"
                                  IsEnabled="{Binding IsLoggedIn}" />
                        <MenuItem Header="_Recent" ItemsSource="{Binding RecentProjects}" IsEnabled="{Binding HasRecent}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Header" Value="{Binding Name}" />
                                    <Setter Property="Command" Value="{Binding OpenCommand}" />
                                    <Setter Property="ToolTip" Value="{Binding Folder}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <MenuItem Header="_Close Project" Command="{Binding CloseProjectCommand}" IsEnabled="{Binding HasBoard}" />
                        <Separator />
                        <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
                    </MenuItem>
                    <MenuItem Header="_Edit">
                        <MenuItem Header="Project _Settings…" Command="{Binding ProjectSettingsCommand}" IsEnabled="{Binding HasBoard}" />
                        <MenuItem Header="Manage _Tags…" Command="{Binding ManageTagsCommand}" IsEnabled="{Binding HasBoard}" />
                        <MenuItem Header="_Archived Cards…" Command="{Binding ArchiveCommand}" IsEnabled="{Binding HasBoard}" />
                        <Separator />
                        <MenuItem Header="Manage _Accounts…" Command="{Binding ManageAccountsCommand}" IsEnabled="{Binding IsLoggedIn}" />
                    </MenuItem>
                    <MenuItem Header="_View">
                        <MenuItem Header="_Kanban Board" Command="{Binding ShowKanbanCommand}" IsEnabled="{Binding HasBoard}"
                                  IsChecked="{Binding Board.IsKanbanMode, Mode=OneWay, FallbackValue=False}" />
                        <MenuItem Header="_Whiteboard" Command="{Binding ShowWhiteboardCommand}" IsEnabled="{Binding HasBoard}"
                                  IsChecked="{Binding Board.IsWhiteboardMode, Mode=OneWay, FallbackValue=False}" />
                        <MenuItem Header="D_ocumentation" Command="{Binding ShowDocsCommand}" IsEnabled="{Binding HasBoard}"
                                  IsChecked="{Binding Board.IsDocsMode, Mode=OneWay, FallbackValue=False}" />
                        <Separator />
                        <MenuItem Header="_Dark Mode" IsCheckable="True" IsChecked="{Binding IsDarkMode, Mode=TwoWay}" />
                    </MenuItem>
                    <MenuItem Header="_Help">
                        <MenuItem Header="_About Cairn" Command="{Binding AboutCommand}" />
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>

        <!-- ===== Status bar ===== -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,4">
            <Grid>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}"
                               Text="{Binding Board.Project.Folder, FallbackValue='Offline · local files only'}" />
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding Board.StatusText, FallbackValue='Ready'}" />
                </DockPanel>
                <!-- Credits: only on the main menu (the list of projects) -->
                <TextBlock Style="{StaticResource Muted}" Text="Designed and realized by Highshore Studio"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsProjectList, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <!-- ===== Current screen ===== -->
        <ContentControl Content="{Binding CurrentView}" Focusable="False" />
    </DockPanel>
</Window>
