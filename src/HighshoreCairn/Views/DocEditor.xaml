<UserControl x:Class="HighshoreCairn.Views.DocEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:HighshoreCairn.Views">

    <!-- Editor of one document. DataContext = DocumentViewModel.
         Two views of the same text: "Preview" (formatted, edited with the toolbar) and "Markdown" (source). -->

    <UserControl.Resources>
        <!-- Tool bar buttons never take the keyboard focus: the selection in the text is kept -->
        <Style x:Key="Tool" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Margin" Value="0,1,1,1" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ToolDivider" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="5,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
        </Style>
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource Brush.Surface}">

        <!-- ===================== Tool bar ===================== -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="6,3"
                Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Menu DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False">
                    <MenuItem Header="More ▾" Padding="7,4">
                        <MenuItem Header="Save now" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                        <MenuItem Header="Export as web page (HTML)…" Command="{Binding ExportHtmlCommand}" />
                        <MenuItem Header="{Binding ConvertText}" Command="{Binding ConvertCommand}" IsEnabled="{Binding CanConvert}"
                                  ToolTip="Turns this document into a rich text document (fonts, sizes, colors, alignment). A copy of the original goes to docs/.trash." />
                        <Separator />
                        <MenuItem Header="Open with the default application" Command="{Binding OpenExternalCommand}" />
                    </MenuItem>
                </Menu>

                <WrapPanel>
                    <!-- View switch -->
                    <Border Style="{StaticResource Card}" CornerRadius="7" Padding="2" Margin="0,1,8,1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource ToolToggle}" Width="Auto" Height="22" Padding="9,0" Margin="0" Content="Preview"
                                         IsChecked="{Binding IsPreview, Mode=OneWay}" Command="{Binding ShowPreviewCommand}"
                                         ToolTip="Formatted text: edit it with the toolbar" />
                            <RadioButton Style="{StaticResource ToolToggle}" Width="Auto" Height="22" Padding="9,0" Margin="0" Content="Markdown"
                                         IsChecked="{Binding IsMarkdown, Mode=OneWay}" Command="{Binding ShowMarkdownCommand}"
                                         ToolTip="The markdown source of the document" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource Tool}" Click="OnTool" Tag="bold" ToolTip="Bold (Ctrl+B)">
                        <TextBlock Text="B" FontWeight="Bold" />
                    </Button>
                    <Button Style="{StaticResource Tool}" Click="OnTool" Tag="italic" ToolTip="Italic (Ctrl+I)">
                        <TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia" />
                    </Button>
                    <Button Style="{StaticResource Tool}" Click="OnTool" Tag="strike" ToolTip="Strikethrough">
                        <TextBlock Text="S" TextDecorations="Strikethrough" />
                    </Button>
                    <Button Style="{StaticResource Tool}" Click="OnTool" Tag="code" ToolTip="Inline code">
                        <TextBlock Text="&lt;/&gt;" FontFamily="Consolas, Courier New" FontSize="12" />
                    </Button>
                    <Border Style="{StaticResource ToolDivider}" />

                    <Button Style="{StaticResource Tool}" Click="OnTool" Tag="p" Content="Text" ToolTip="Normal paragraph" />
                    <Button Style="{StaticResource Tool}" Click="OnTool" Tag="h1" Content="H1" ToolTip="Heading 1" FontWeight="SemiBold" />
                    <Button Style="{StaticResource Tool}" Click="OnTool" Tag="h2" Content="H2" ToolTip="Heading 2" FontWeight="SemiBold" />
                    <Button Style="{StaticResource Tool}" Click="OnTool" Tag="h3" Content="H3" ToolTip="Heading 3" FontWeight="SemiBold" />
                    <Border Style="{StaticResource ToolDivider}" />

                    <Button Style="{StaticResource Tool}" Click="OnTool" Tag="ul" Content="• List" ToolTip="Bulleted list" />
                    <Button Style="{StaticResource Tool}" Click="OnTool" Tag="ol" Content="1. List" ToolTip="Numbered list" />
                    <Button Style="{StaticResource Tool}" Click="OnTool" Tag="task" Content="Tasks" ToolTip="Task list with check boxes" />
                    <Button Style="{StaticResource Tool}" Click="OnTool" Tag="quote" Content="Quote" ToolTip="Quote" />
                    <Button Style="{StaticResource Tool}" Click="OnTool" Tag="codeblock" Content="Code" ToolTip="Code block" />
                    <Border Style="{StaticResource ToolDivider}" />

                    <Button Style="{StaticResource Tool}" Click="OnTool" Tag="link" Content="Link" ToolTip="Web link (Ctrl+K)" />
                    <Button Style="{StaticResource Tool}" Click="OnTool" Tag="wiki" Content="[[Doc]]" ToolTip="Link to another document of the project" />
                    <Button Style="{StaticResource Tool}" Click="OnTool" Tag="image" Content="Image" ToolTip="Insert a picture (you can also paste a screenshot or drop a file)" />
                    <Button Style="{StaticResource Tool}" Click="OnTool" Tag="table" Content="Table" ToolTip="Insert a table" />
                    <Button Style="{StaticResource Tool}" Click="OnTool" Tag="rule" Content="Line" ToolTip="Horizontal line" />
                    <Border Style="{StaticResource ToolDivider}" />

                    <Button Style="{StaticResource Tool}" Click="OnTool" Tag="undo" Content="Undo" ToolTip="Ctrl+Z" />
                    <Button Style="{StaticResource Tool}" Click="OnTool" Tag="redo" Content="Redo" ToolTip="Ctrl+Y" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Notice: the formatted view is read-only for this document -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.AccentLight}" Padding="12,5"
                Visibility="{Binding ShowPreviewLock, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding PreviewLockText}" Foreground="{DynamicResource Brush.AccentText}" TextWrapping="Wrap" FontSize="12" />
        </Border>

        <!-- ===================== Status ===================== -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="10,3">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="HintText" Style="{StaticResource Muted}" Margin="12,0,0,0" />
                <TextBlock Style="{StaticResource Muted}" Text="{Binding StatsText}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- ===================== Text ===================== -->
        <Grid>
            <!-- Markdown view -->
            <TextBox x:Name="Source" Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" BorderThickness="0"
                     FontFamily="Consolas, Courier New" FontSize="13.5" Padding="18,14"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     VerticalContentAlignment="Top" AllowDrop="True"
                     PreviewKeyDown="Source_PreviewKeyDown" PreviewDragOver="Editor_PreviewDragOver" PreviewDrop="Source_PreviewDrop"
                     Visibility="{Binding ShowSource, Converter={StaticResource BoolToVis}}" />

            <!-- Preview view (formatted text) -->
            <RichTextBox x:Name="Rich" BorderThickness="0" Padding="18,14" AcceptsTab="True" IsDocumentEnabled="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowDrop="True"
                         TextChanged="Rich_TextChanged" PreviewKeyDown="Rich_PreviewKeyDown"
                         PreviewMouseLeftButtonDown="Rich_PreviewMouseLeftButtonDown"
                         PreviewDragOver="Editor_PreviewDragOver" PreviewDrop="Rich_PreviewDrop"
                         Visibility="{Binding ShowFormatted, Converter={StaticResource BoolToVis}}" />

            <!-- Rich text documents (.rtf) have their own editor and toolbar -->
            <v:RichDocEditor Visibility="{Binding ShowRich, Converter={StaticResource BoolToVis}}" />

            <!-- Pictures are shown, not edited -->
            <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource Brush.Canvas}"
                          Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                <Image Source="{Binding ImageFile, Converter={StaticResource FileToImage}}" Stretch="None" Margin="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            </ScrollViewer>

            <!-- The file could not be read (for example a link to a file that was deleted) -->
            <Border Background="{DynamicResource Brush.Surface}" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="24"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
